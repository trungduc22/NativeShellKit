<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <PackageId>NativeShellKit.Windows</PackageId>
    <Description>Win32 P/Invoke wrappers, Windows version detection, Known Folders, single-instance coordination, startup registration, and system service adapters for NativeShellKit.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="$(SystemEventsPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeShellKit.Abstractions\NativeShellKit.Abstractions.csproj" />
  </ItemGroup>
</Project>
