<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <PackageId>NativeShellKit.Security</PackageId>
    <Description>Per-identity DPAPI secret storage, safe path validation, secret redaction, and HMAC IPC authentication for NativeShellKit.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="$(ProtectedDataPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeShellKit.Abstractions\NativeShellKit.Abstractions.csproj" />
  </ItemGroup>
</Project>
