<UserControl
    x:Class="NativeShellKit.WinUI.Shell.ShellTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="44">
    <Grid
        x:Name="TitleBarRoot"
        MinHeight="36"
        Height="44"
        Padding="16,0,148,0"
        Background="Transparent"
        ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center">
            <Border
                x:Name="IconBadge"
                Width="24"
                Height="24"
                CornerRadius="6"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <Grid>
                    <FontIcon
                        x:Name="BrandGlyphIcon"
                        Glyph="&#xE756;"
                        FontSize="13"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <Image
                        x:Name="BrandImageIcon"
                        Width="20"
                        Height="20"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <TextBlock
                x:Name="TitleTextBlock"
                Text="NativeShellKit"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="SubtitleTextBlock"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />
        </StackPanel>

        <ContentPresenter
            x:Name="CenterSlotPresenter"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            MaxWidth="480" />

        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <ContentPresenter
                x:Name="StatusSlotPresenter"
                VerticalAlignment="Center" />
            <ContentPresenter
                x:Name="RightSlotPresenter"
                VerticalAlignment="Center" />
            <Button
                x:Name="ThemeToggleButton"
                UseSystemFocusVisuals="True"
                Padding="8,5"
                Click="ThemeToggleButton_Click">
                <FontIcon Glyph="&#xE793;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
