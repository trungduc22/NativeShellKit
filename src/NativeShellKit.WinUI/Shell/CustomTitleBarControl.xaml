<UserControl
    x:Class="NativeShellKit.WinUI.Shell.CustomTitleBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="48">
    <Grid
        x:Name="TitleBarRoot"
        Height="48"
        Padding="16,0,148,0"
        Background="Transparent"
        ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center">
            <Border
                Width="24"
                Height="24"
                CornerRadius="6"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon
                    Glyph="&#xE756;"
                    FontSize="13"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                x:Name="TitleTextBlock"
                Text="NativeShellKit"
                FontSize="13"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="SubtitleTextBlock"
                Opacity="0.65"
                FontSize="12"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </StackPanel>

        <ContentPresenter
            x:Name="CenterSlotPresenter"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            MaxWidth="480" />

        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <ContentPresenter
                x:Name="RightSlotPresenter"
                VerticalAlignment="Center" />
            <Button
                x:Name="ThemeToggleButton"
                AutomationProperties.Name="Toggle theme"
                ToolTipService.ToolTip="Switch theme"
                Padding="8,5"
                Click="ThemeToggleButton_Click">
                <FontIcon Glyph="&#xE793;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
