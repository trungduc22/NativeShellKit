<UserControl
    x:Class="NativeShellKit.WinUI.Shell.NativeShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:NativeShellKit.WinUI.Shell">
    <Grid x:Name="ShellRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <shell:CustomTitleBarControl
            x:Name="TitleBar"
            Grid.Row="0" />

        <NavigationView
            x:Name="ShellNavigationView"
            Grid.Row="1"
            IsBackEnabled="{x:Bind CanGoBack, Mode=OneWay}"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            CompactPaneLength="48"
            SelectionChanged="ShellNavigationView_SelectionChanged"
            BackRequested="ShellNavigationView_BackRequested">
            <Grid Padding="24,16,24,24" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentPresenter
                    x:Name="NotificationBannerHost"
                    Grid.Row="0"
                    Visibility="Collapsed" />

                <ContentPresenter
                    x:Name="PageContentHost"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
