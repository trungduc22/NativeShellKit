<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <PackageId>NativeShellKit.WinUI</PackageId>
    <Description>Native WinUI 3 application shell, custom title bar, navigation, theming, dialog coordination, and MVVM primitives for NativeShellKit.</Description>
    <IsPackable>true</IsPackable>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeWinUiXbfInPack</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="IncludeWinUiXbfInPack">
    <PropertyGroup>
      <_NuGetShortTfm>$([System.Text.RegularExpressions.Regex]::Replace('$(TargetFramework)', '\.0$', ''))</_NuGetShortTfm>
    </PropertyGroup>
    <ItemGroup>
      <_WinUiXbfFiles Include="$(OutDir)$(AssemblyName)\**\*.xbf" />
      <TfmSpecificPackageFile Include="@(_WinUiXbfFiles)"
                              PackagePath="lib\$(_NuGetShortTfm)\$(AssemblyName)\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="buildTransitive\NativeShellKit.WinUI.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\NativeShellKit.WinUI.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(MicrosoftWindowsAppSDKVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeShellKit.Abstractions\NativeShellKit.Abstractions.csproj" />
    <ProjectReference Include="..\NativeShellKit.Hosting\NativeShellKit.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NativeShellKit.Tests" />
  </ItemGroup>
</Project>
