<Project>
  <Target Name="_IncludeNativeShellKitWinUiAssetsInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_NskWinUiPublishXbf Include="$(MSBuildThisFileDirectory)..\lib\net10.0-windows10.0.19041\NativeShellKit.WinUI\**\*.xbf" />
      <_NskWinUiPublishPri Include="$(MSBuildThisFileDirectory)..\lib\net10.0-windows10.0.19041\NativeShellKit.WinUI.pri" />
      <ResolvedFileToPublish Include="@(_NskWinUiPublishXbf)">
        <RelativePath>NativeShellKit.WinUI\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_NskWinUiPublishPri)" Condition="Exists('%(_NskWinUiPublishPri.Identity)')">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="_CopyNativeShellKitWinUiXbf" AfterTargets="Build;Publish">
    <ItemGroup>
      <_NskWinUiXbf Include="$(MSBuildThisFileDirectory)..\lib\net10.0-windows10.0.19041\NativeShellKit.WinUI\**\*.xbf" />
      <_NskWinUiPri Include="$(MSBuildThisFileDirectory)..\lib\net10.0-windows10.0.19041\NativeShellKit.WinUI.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_NskWinUiXbf)"
          DestinationFiles="@(_NskWinUiXbf->'$(OutDir)NativeShellKit.WinUI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_NskWinUiXbf)' != '' and '$(OutDir)' != ''" />
    <Copy SourceFiles="@(_NskWinUiPri)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_NskWinUiPri)' != '' and Exists('@(_NskWinUiPri)') and '$(OutDir)' != ''" />
    <Copy SourceFiles="@(_NskWinUiXbf)"
          DestinationFiles="@(_NskWinUiXbf->'$(PublishDir)NativeShellKit.WinUI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_NskWinUiXbf)' != '' and '$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
</Project>
