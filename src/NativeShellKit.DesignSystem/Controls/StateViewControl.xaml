<UserControl
    x:Class="NativeShellKit.DesignSystem.Controls.StateViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ContentPresenter
            x:Name="MainContentPresenter"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <StackPanel
            x:Name="OverlayPanel"
            Spacing="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="420"
            Visibility="Collapsed">
            <ProgressRing
                x:Name="LoadingRing"
                Width="32"
                Height="32"
                IsActive="False"
                Visibility="Collapsed"
                HorizontalAlignment="Center" />
            <FontIcon
                x:Name="StateIcon"
                FontSize="32"
                Opacity="0.7"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="StateTitleText"
                FontSize="16"
                FontWeight="SemiBold"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="StateMessageText"
                FontSize="13"
                Opacity="0.72"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="RetryButton"
                Content="Retry"
                HorizontalAlignment="Center"
                Visibility="Collapsed"
                Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
