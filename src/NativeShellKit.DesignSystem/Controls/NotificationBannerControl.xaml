<UserControl
    x:Class="NativeShellKit.DesignSystem.Controls.NotificationBannerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <InfoBar
        x:Name="BannerInfoBar"
        IsOpen="True"
        IsClosable="True"
        Closed="BannerInfoBar_Closed">
        <InfoBar.ActionButton>
            <Button
                x:Name="BannerActionButton"
                Visibility="Collapsed"
                Click="BannerActionButton_Click" />
        </InfoBar.ActionButton>
    </InfoBar>
</UserControl>
