<UserControl
    x:Class="NativeShellKit.DesignSystem.Controls.PageHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="16" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="4">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleTextBlock"
                    Grid.Column="0"
                    FontSize="24"
                    FontWeight="SemiBold"
                    AutomationProperties.HeadingLevel="Level1"
                    TextWrapping="Wrap" />
                <Border
                    x:Name="BadgeContainer"
                    Grid.Column="1"
                    CornerRadius="10"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NativeShellInfoBgBrush}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="BadgeTextBlock"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource NativeShellInfoFgBrush}" />
                </Border>
            </Grid>
            <TextBlock
                x:Name="SubtitleTextBlock"
                FontSize="13"
                Opacity="0.72"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <ContentPresenter
            x:Name="ActionsPresenter"
            Grid.Column="1"
            VerticalAlignment="Center" />
    </Grid>
</UserControl>
