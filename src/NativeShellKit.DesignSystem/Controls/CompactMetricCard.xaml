<UserControl
    x:Class="NativeShellKit.DesignSystem.Controls.CompactMetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        CornerRadius="8"
        BorderThickness="1"
        Padding="14,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid RowSpacing="6" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="LabelTextBlock"
                Grid.Row="0"
                Grid.Column="0"
                FontSize="12"
                Opacity="0.72"
                TextTrimming="CharacterEllipsis" />

            <FontIcon
                x:Name="CardIcon"
                Grid.Row="0"
                Grid.Column="1"
                FontSize="14"
                Opacity="0.8" />

            <TextBlock
                x:Name="ValueTextBlock"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                FontSize="22"
                FontWeight="SemiBold" />

            <TextBlock
                x:Name="CaptionTextBlock"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                FontSize="11"
                Opacity="0.68"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
