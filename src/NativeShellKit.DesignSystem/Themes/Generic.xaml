<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NativeShellKit.DesignSystem.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens/SurfacesAndColors.xaml" />
        <ResourceDictionary Source="Tokens/Typography.xaml" />
        <ResourceDictionary Source="Tokens/MetricsAndRadii.xaml" />
        <ResourceDictionary Source="Tokens/DensityStandard.xaml" />
        <ResourceDictionary Source="Tokens/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- StatusBadge -->
    <Style TargetType="controls:StatusBadge">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusBadge">
                    <Border
                        x:Name="PillBorder"
                        CornerRadius="{StaticResource NskRadiusPill}"
                        BorderThickness="{StaticResource NskBorderThin}"
                        BorderBrush="{ThemeResource NskStrokeHairlineBrush}"
                        Background="{ThemeResource NskStatusSuccessBgBrush}"
                        Padding="10,4"
                        VerticalAlignment="Center">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="StatusStates">
                                <VisualState x:Name="Healthy">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background" Value="{ThemeResource NskStatusSuccessBgBrush}" />
                                        <Setter Target="DotEllipse.Fill" Value="{ThemeResource NskStatusSuccessFgBrush}" />
                                        <Setter Target="LabelBlock.Foreground" Value="{ThemeResource NskStatusSuccessFgBrush}" />
                                        <Setter Target="SyncRing.IsActive" Value="False" />
                                        <Setter Target="SyncRing.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Active">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background" Value="{ThemeResource NskStatusActiveBgBrush}" />
                                        <Setter Target="DotEllipse.Fill" Value="{ThemeResource NskStatusActiveFgBrush}" />
                                        <Setter Target="LabelBlock.Foreground" Value="{ThemeResource NskStatusActiveFgBrush}" />
                                        <Setter Target="SyncRing.IsActive" Value="False" />
                                        <Setter Target="SyncRing.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Warning">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background" Value="{ThemeResource NskStatusWarningBgBrush}" />
                                        <Setter Target="DotEllipse.Fill" Value="{ThemeResource NskStatusWarningFgBrush}" />
                                        <Setter Target="LabelBlock.Foreground" Value="{ThemeResource NskStatusWarningFgBrush}" />
                                        <Setter Target="SyncRing.IsActive" Value="False" />
                                        <Setter Target="SyncRing.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background" Value="{ThemeResource NskStatusDangerBgBrush}" />
                                        <Setter Target="DotEllipse.Fill" Value="{ThemeResource NskStatusDangerFgBrush}" />
                                        <Setter Target="LabelBlock.Foreground" Value="{ThemeResource NskStatusDangerFgBrush}" />
                                        <Setter Target="SyncRing.IsActive" Value="False" />
                                        <Setter Target="SyncRing.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Offline">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background" Value="{ThemeResource NskStatusOfflineBgBrush}" />
                                        <Setter Target="DotEllipse.Fill" Value="{ThemeResource NskStatusOfflineFgBrush}" />
                                        <Setter Target="LabelBlock.Foreground" Value="{ThemeResource NskStatusOfflineFgBrush}" />
                                        <Setter Target="SyncRing.IsActive" Value="False" />
                                        <Setter Target="SyncRing.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Syncing">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background" Value="{ThemeResource NskStatusActiveBgBrush}" />
                                        <Setter Target="DotEllipse.Visibility" Value="Collapsed" />
                                        <Setter Target="SyncRing.Visibility" Value="Visible" />
                                        <Setter Target="SyncRing.IsActive" Value="True" />
                                        <Setter Target="LabelBlock.Foreground" Value="{ThemeResource NskStatusActiveFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CompactStates">
                                <VisualState x:Name="CompactOff" />
                                <VisualState x:Name="CompactOn">
                                    <VisualState.Setters>
                                        <Setter Target="LabelBlock.Visibility" Value="Collapsed" />
                                        <Setter Target="PillBorder.Padding" Value="6" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DotStates">
                                <VisualState x:Name="DotVisible" />
                                <VisualState x:Name="DotCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="DotEllipse.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="DotEllipse"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center" />
                            <ProgressRing
                                x:Name="SyncRing"
                                Width="10"
                                Height="10"
                                IsActive="False"
                                Visibility="Collapsed"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="LabelBlock"
                                Style="{StaticResource NskCaptionStrongTextStyle}"
                                Text="{TemplateBinding Label}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PageHeader -->
    <Style TargetType="controls:PageHeader">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Grid Margin="0,0,0,12" ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SubtitleStates">
                                <VisualState x:Name="SubtitleVisible" />
                                <VisualState x:Name="SubtitleCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="SubtitleBlock.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="BadgeStates">
                                <VisualState x:Name="BadgeVisible" />
                                <VisualState x:Name="BadgeCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderBadge.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ResponsiveStates">
                                <VisualState x:Name="WideLayout" />
                                <VisualState x:Name="NarrowLayout">
                                    <VisualState.Setters>
                                        <Setter Target="ActionsHost.(Grid.Row)" Value="1" />
                                        <Setter Target="ActionsHost.(Grid.Column)" Value="0" />
                                        <Setter Target="ActionsHost.(Grid.ColumnSpan)" Value="2" />
                                        <Setter Target="ActionsHost.HorizontalAlignment" Value="Left" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <BreadcrumbBar
                                x:Name="PART_Breadcrumb"
                                Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    Style="{StaticResource NskPageTitleTextStyle}"
                                    Foreground="{ThemeResource NskTextPrimaryBrush}"
                                    Text="{TemplateBinding Title}"
                                    AutomationProperties.HeadingLevel="Level1"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <controls:StatusBadge
                                    x:Name="HeaderBadge"
                                    State="{TemplateBinding BadgeState}"
                                    Label="{TemplateBinding BadgeLabel}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                x:Name="SubtitleBlock"
                                Style="{StaticResource NskBodyTextStyle}"
                                Foreground="{ThemeResource NskTextSecondaryBrush}"
                                Text="{TemplateBinding Subtitle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ContentPresenter
                            x:Name="ActionsHost"
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="{TemplateBinding ActionsContent}"
                            VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MetricCard -->
    <Style TargetType="controls:MetricCard">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MetricCard">
                    <Border
                        x:Name="RootBorder"
                        CornerRadius="{StaticResource NskRadiusCard}"
                        BorderThickness="{StaticResource NskBorderThin}"
                        Padding="{StaticResource NskCardPadding}"
                        Background="{ThemeResource NskSurfaceCardBrush}"
                        BorderBrush="{ThemeResource NskStrokeCardBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource NskSurfaceCardHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource NskSurfaceSubtleBrush}" />
                                        <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource NskStrokeStrongBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="LoadingStates">
                                <VisualState x:Name="Ready" />
                                <VisualState x:Name="Loading">
                                    <VisualState.Setters>
                                        <Setter Target="ValueBlock.Visibility" Value="Collapsed" />
                                        <Setter Target="LoadingPlaceholder.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CaptionStates">
                                <VisualState x:Name="CaptionVisible" />
                                <VisualState x:Name="CaptionCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="CaptionBlock.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="GlyphStates">
                                <VisualState x:Name="GlyphVisible" />
                                <VisualState x:Name="GlyphCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="GlyphIcon.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="TrendStates">
                                <VisualState x:Name="TrendNeutral" />
                                <VisualState x:Name="TrendHealthy">
                                    <VisualState.Setters>
                                        <Setter Target="CaptionBlock.Foreground" Value="{ThemeResource NskStatusSuccessFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TrendActive">
                                    <VisualState.Setters>
                                        <Setter Target="CaptionBlock.Foreground" Value="{ThemeResource NskStatusActiveFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TrendWarning">
                                    <VisualState.Setters>
                                        <Setter Target="CaptionBlock.Foreground" Value="{ThemeResource NskStatusWarningFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TrendError">
                                    <VisualState.Setters>
                                        <Setter Target="CaptionBlock.Foreground" Value="{ThemeResource NskStatusDangerFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid RowSpacing="6" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource NskCaptionTextStyle}"
                                Foreground="{ThemeResource NskTextSecondaryBrush}"
                                Text="{TemplateBinding Label}"
                                TextTrimming="CharacterEllipsis" />

                            <FontIcon
                                x:Name="GlyphIcon"
                                Grid.Row="0"
                                Grid.Column="1"
                                Glyph="{TemplateBinding Glyph}"
                                FontSize="14"
                                Foreground="{ThemeResource NskTextSecondaryBrush}" />

                            <TextBlock
                                x:Name="ValueBlock"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource NskDisplayMetricTextStyle}"
                                Foreground="{ThemeResource NskTextPrimaryBrush}"
                                Typography.NumeralAlignment="Tabular"
                                Text="{TemplateBinding Value}"
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                x:Name="LoadingPlaceholder"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Height="28"
                                CornerRadius="{StaticResource NskRadiusControl}"
                                Background="{ThemeResource NskSurfaceSubtleBrush}"
                                Visibility="Collapsed" />

                            <TextBlock
                                x:Name="CaptionBlock"
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource NskCaptionTextStyle}"
                                Foreground="{ThemeResource NskTextSecondaryBrush}"
                                Text="{TemplateBinding Caption}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StateView -->
    <Style TargetType="controls:StateView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StateView">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ViewStates">
                                <VisualState x:Name="Content">
                                    <VisualState.Setters>
                                        <Setter Target="MainPresenter.Visibility" Value="Visible" />
                                        <Setter Target="OverlayPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="SkeletonPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="LoadingRing.IsActive" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Loading">
                                    <VisualState.Setters>
                                        <Setter Target="MainPresenter.Visibility" Value="Collapsed" />
                                        <Setter Target="SkeletonPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="OverlayPanel.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.IsActive" Value="True" />
                                        <Setter Target="StateIcon.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Skeleton">
                                    <VisualState.Setters>
                                        <Setter Target="MainPresenter.Visibility" Value="Collapsed" />
                                        <Setter Target="OverlayPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="SkeletonPanel.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.IsActive" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Empty">
                                    <VisualState.Setters>
                                        <Setter Target="MainPresenter.Visibility" Value="Collapsed" />
                                        <Setter Target="SkeletonPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="OverlayPanel.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.IsActive" Value="False" />
                                        <Setter Target="LoadingRing.Visibility" Value="Collapsed" />
                                        <Setter Target="StateIcon.Visibility" Value="Visible" />
                                        <Setter Target="StateIcon.Foreground" Value="{ThemeResource NskTextSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="MainPresenter.Visibility" Value="Collapsed" />
                                        <Setter Target="SkeletonPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="OverlayPanel.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.IsActive" Value="False" />
                                        <Setter Target="LoadingRing.Visibility" Value="Collapsed" />
                                        <Setter Target="StateIcon.Visibility" Value="Visible" />
                                        <Setter Target="StateIcon.Foreground" Value="{ThemeResource NskStatusDangerFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Offline">
                                    <VisualState.Setters>
                                        <Setter Target="MainPresenter.Visibility" Value="Collapsed" />
                                        <Setter Target="SkeletonPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="OverlayPanel.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.IsActive" Value="False" />
                                        <Setter Target="LoadingRing.Visibility" Value="Collapsed" />
                                        <Setter Target="StateIcon.Visibility" Value="Visible" />
                                        <Setter Target="StateIcon.Foreground" Value="{ThemeResource NskStatusOfflineFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Degraded">
                                    <VisualState.Setters>
                                        <Setter Target="MainPresenter.Visibility" Value="Visible" />
                                        <Setter Target="MainPresenter.Opacity" Value="0.55" />
                                        <Setter Target="SkeletonPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="OverlayPanel.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.IsActive" Value="False" />
                                        <Setter Target="LoadingRing.Visibility" Value="Collapsed" />
                                        <Setter Target="StateIcon.Visibility" Value="Visible" />
                                        <Setter Target="StateIcon.Foreground" Value="{ThemeResource NskStatusWarningFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter
                            x:Name="MainPresenter"
                            Content="{TemplateBinding BodyContent}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

                        <StackPanel
                            x:Name="SkeletonPanel"
                            Spacing="10"
                            Visibility="Collapsed"
                            VerticalAlignment="Top">
                            <ContentPresenter ContentTemplate="{TemplateBinding SkeletonTemplate}" />
                            <Border Height="22" CornerRadius="{StaticResource NskRadiusControl}" Background="{ThemeResource NskSurfaceSubtleBrush}" />
                            <Border Height="64" CornerRadius="{StaticResource NskRadiusCard}" Background="{ThemeResource NskSurfaceSubtleBrush}" />
                        </StackPanel>

                        <Border
                            x:Name="OverlayPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="{StaticResource NskCardPadding}"
                            CornerRadius="{StaticResource NskRadiusCard}"
                            Background="{ThemeResource NskSurfaceCardBrush}"
                            BorderBrush="{ThemeResource NskStrokeCardBrush}"
                            BorderThickness="{StaticResource NskBorderThin}"
                            MaxWidth="440">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <ProgressRing
                                    x:Name="LoadingRing"
                                    Width="32"
                                    Height="32"
                                    IsActive="False"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center" />
                                <FontIcon
                                    x:Name="StateIcon"
                                    Glyph="{TemplateBinding ResolvedGlyph}"
                                    FontSize="32"
                                    Foreground="{ThemeResource NskTextSecondaryBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Style="{StaticResource NskSubtitleTextStyle}"
                                    Foreground="{ThemeResource NskTextPrimaryBrush}"
                                    Text="{TemplateBinding Title}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource NskBodyTextStyle}"
                                    Foreground="{ThemeResource NskTextSecondaryBrush}"
                                    Text="{TemplateBinding Message}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button
                                        x:Name="PART_PrimaryButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="{TemplateBinding PrimaryActionLabel}"
                                        UseSystemFocusVisuals="True"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="PART_SecondaryButton"
                                        Content="{TemplateBinding SecondaryActionLabel}"
                                        UseSystemFocusVisuals="True"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NotificationBanner -->
    <Style TargetType="controls:NotificationBanner">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:NotificationBanner">
                    <InfoBar
                        x:Name="PART_InfoBar"
                        Title="{TemplateBinding Title}"
                        Message="{TemplateBinding Message}"
                        Severity="{TemplateBinding Severity}"
                        IsOpen="{TemplateBinding IsOpen}"
                        IsClosable="True"
                        CornerRadius="{StaticResource NskRadiusCard}">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="PART_ActionButton"
                                Content="{TemplateBinding ActionLabel}"
                                Visibility="Collapsed" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SettingsSection -->
    <Style TargetType="controls:SettingsSection">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsSection">
                    <StackPanel Spacing="8" Margin="0,0,0,16">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DescriptionStates">
                                <VisualState x:Name="DescriptionVisible" />
                                <VisualState x:Name="DescriptionCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="SectionDescriptionBlock.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Style="{StaticResource NskSectionTitleTextStyle}"
                                    Foreground="{ThemeResource NskTextPrimaryBrush}"
                                    Text="{TemplateBinding Title}"
                                    AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock
                                    x:Name="SectionDescriptionBlock"
                                    Style="{StaticResource NskCaptionTextStyle}"
                                    Foreground="{ThemeResource NskTextSecondaryBrush}"
                                    Text="{TemplateBinding Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentPresenter
                                Grid.Column="1"
                                Content="{TemplateBinding HeaderActionContent}"
                                VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="PART_RowsHost" Spacing="6" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SettingsRow -->
    <Style TargetType="controls:SettingsRow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsRow">
                    <Border
                        CornerRadius="{StaticResource NskRadiusCard}"
                        BorderThickness="{StaticResource NskBorderThin}"
                        Padding="{StaticResource NskRowPadding}"
                        Background="{ThemeResource NskSurfaceCardBrush}"
                        BorderBrush="{ThemeResource NskStrokeCardBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DescriptionStates">
                                <VisualState x:Name="DescriptionVisible" />
                                <VisualState x:Name="DescriptionCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="DescriptionBlock.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="GlyphStates">
                                <VisualState x:Name="GlyphVisible" />
                                <VisualState x:Name="GlyphCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="RowGlyphIcon.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ValidationStates">
                                <VisualState x:Name="ValidationVisible" />
                                <VisualState x:Name="ValidationCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="ValidationBlock.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ExpandabilityStates">
                                <VisualState x:Name="StandardRow">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpandButton.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Expandable">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpandButton.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ExpandedStates">
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="ExpandedHost.Visibility" Value="Collapsed" />
                                        <Setter Target="ChevronGlyph.Glyph" Value="&#xE70D;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="ExpandedHost.Visibility" Value="Visible" />
                                        <Setter Target="ChevronGlyph.Glyph" Value="&#xE70E;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    x:Name="RowGlyphIcon"
                                    Grid.Column="0"
                                    Glyph="{TemplateBinding Glyph}"
                                    FontSize="18"
                                    Foreground="{ThemeResource NskTextSecondaryBrush}"
                                    VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource NskBodyStrongTextStyle}"
                                        Foreground="{ThemeResource NskTextPrimaryBrush}"
                                        Text="{TemplateBinding Header}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="DescriptionBlock"
                                        Style="{StaticResource NskCaptionTextStyle}"
                                        Foreground="{ThemeResource NskTextSecondaryBrush}"
                                        Text="{TemplateBinding Description}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ValidationBlock"
                                        Style="{StaticResource NskCaptionTextStyle}"
                                        Foreground="{ThemeResource NskStatusWarningFgBrush}"
                                        Text="{TemplateBinding ValidationMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ContentPresenter
                                    Grid.Column="2"
                                    Content="{TemplateBinding ActionContent}"
                                    VerticalAlignment="Center" />

                                <Button
                                    x:Name="PART_ExpandButton"
                                    Grid.Column="3"
                                    Padding="8,6"
                                    UseSystemFocusVisuals="True"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                    <FontIcon x:Name="ChevronGlyph" Glyph="&#xE70D;" FontSize="12" />
                                </Button>
                            </Grid>

                            <Border
                                x:Name="ExpandedHost"
                                BorderBrush="{ThemeResource NskStrokeHairlineBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Visibility="Collapsed">
                                <ContentPresenter Content="{TemplateBinding ExpandedContent}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SearchBox -->
    <Style TargetType="controls:SearchBox">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SearchBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="HintStates">
                                <VisualState x:Name="HintCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="ShortcutBadge.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="HintVisible">
                                    <VisualState.Setters>
                                        <Setter Target="ShortcutBadge.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <AutoSuggestBox
                            x:Name="PART_AutoSuggestBox"
                            MinHeight="{StaticResource NskMinInteractiveHeight}"
                            QueryIcon="Find"
                            PlaceholderText="{TemplateBinding Placeholder}"
                            ItemsSource="{TemplateBinding ItemsSource}"
                            AutomationProperties.Name="{TemplateBinding AccessibleName}" />
                        <Border
                            x:Name="ShortcutBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,36,0"
                            Padding="6,2"
                            CornerRadius="{StaticResource NskRadiusControl}"
                            Background="{ThemeResource NskSurfaceSubtleBrush}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{StaticResource NskCaptionStrongTextStyle}"
                                Foreground="{ThemeResource NskTextTertiaryBrush}"
                                Text="{TemplateBinding ShortcutHint}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CompactMediaBar -->
    <Style TargetType="controls:CompactMediaBar">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CompactMediaBar">
                    <Border
                        x:Name="ContainerBorder"
                        CornerRadius="{StaticResource NskRadiusCard}"
                        BorderThickness="{StaticResource NskBorderThin}"
                        Padding="{StaticResource NskCardPadding}"
                        Background="{ThemeResource NskSurfaceCardBrush}"
                        BorderBrush="{ThemeResource NskStrokeCardBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LayoutStates">
                                <VisualState x:Name="CardLayout" />
                                <VisualState x:Name="StripLayout">
                                    <VisualState.Setters>
                                        <Setter Target="ContainerBorder.Padding" Value="12,8" />
                                        <Setter Target="SeekRowGrid.Visibility" Value="Collapsed" />
                                        <Setter Target="RouteRowPanel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ArtworkStates">
                                <VisualState x:Name="ArtworkFallback" />
                                <VisualState x:Name="ArtworkImage">
                                    <VisualState.Setters>
                                        <Setter Target="ArtworkFallbackIcon.Visibility" Value="Collapsed" />
                                        <Setter Target="ArtworkImageHost.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="{StaticResource NskRadiusControl}"
                                    Background="{ThemeResource NskSurfaceSubtleBrush}">
                                    <Grid>
                                        <FontIcon
                                            x:Name="ArtworkFallbackIcon"
                                            Glyph="&#xE8D6;"
                                            FontSize="18"
                                            Foreground="{ThemeResource NskTextSecondaryBrush}" />
                                        <Image
                                            x:Name="ArtworkImageHost"
                                            Source="{TemplateBinding ArtworkSource}"
                                            Stretch="UniformToFill"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource NskBodyStrongTextStyle}"
                                            Foreground="{ThemeResource NskTextPrimaryBrush}"
                                            Text="{TemplateBinding Title}"
                                            ToolTipService.ToolTip="{TemplateBinding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <controls:StatusBadge
                                            State="{TemplateBinding ConnectionState}"
                                            Label="{TemplateBinding RouteLabel}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            Style="{StaticResource NskCaptionTextStyle}"
                                            Foreground="{ThemeResource NskTextSecondaryBrush}"
                                            Text="{TemplateBinding Artist}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource NskCaptionTextStyle}"
                                            Foreground="{ThemeResource NskTextTertiaryBrush}"
                                            Text="{TemplateBinding ProviderLabel}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button
                                        Command="{TemplateBinding PreviousCommand}"
                                        AutomationProperties.Name="{TemplateBinding PreviousLabel}"
                                        UseSystemFocusVisuals="True"
                                        Padding="8,6">
                                        <FontIcon Glyph="&#xE892;" FontSize="13" />
                                    </Button>
                                    <Button
                                        Command="{TemplateBinding PlayPauseCommand}"
                                        AutomationProperties.Name="{TemplateBinding PlayPauseAccessibleName}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        UseSystemFocusVisuals="True"
                                        Padding="10,6">
                                        <FontIcon Glyph="{TemplateBinding PlayPauseGlyph}" FontSize="14" />
                                    </Button>
                                    <Button
                                        Command="{TemplateBinding NextCommand}"
                                        AutomationProperties.Name="{TemplateBinding NextLabel}"
                                        UseSystemFocusVisuals="True"
                                        Padding="8,6">
                                        <FontIcon Glyph="&#xE893;" FontSize="13" />
                                    </Button>
                                    <Button
                                        Command="{TemplateBinding ToggleMuteCommand}"
                                        AutomationProperties.Name="{TemplateBinding VolumeLabel}"
                                        UseSystemFocusVisuals="True"
                                        Padding="8,6">
                                        <FontIcon Glyph="{TemplateBinding MuteGlyph}" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="SeekRowGrid" Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Slider
                                    x:Name="PART_SeekSlider"
                                    Grid.Column="0"
                                    IsEnabled="{TemplateBinding CanSeek}"
                                    AutomationProperties.Name="{TemplateBinding SeekSliderLabel}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource NskCaptionTextStyle}"
                                    Foreground="{ThemeResource NskTextSecondaryBrush}"
                                    Typography.NumeralAlignment="Tabular"
                                    Text="{TemplateBinding TimeDisplayText}"
                                    VerticalAlignment="Center" />

                                <StackPanel
                                    x:Name="RouteRowPanel"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <Button
                                        x:Name="PART_HandoffButton"
                                        Content="{TemplateBinding HandoffLabel}"
                                        Command="{TemplateBinding HandoffCommand}"
                                        UseSystemFocusVisuals="True" />
                                    <Button
                                        x:Name="PART_ReturnToPcButton"
                                        Content="{TemplateBinding ReturnToPcLabel}"
                                        Command="{TemplateBinding ReturnToPcCommand}"
                                        UseSystemFocusVisuals="True" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressBanner -->
    <Style TargetType="controls:ProgressBanner">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ProgressBanner">
                    <Border
                        CornerRadius="{StaticResource NskRadiusCard}"
                        BorderThickness="{StaticResource NskBorderThin}"
                        Padding="{StaticResource NskCardPadding}"
                        Background="{ThemeResource NskSurfaceCardBrush}"
                        BorderBrush="{ThemeResource NskStrokeCardBrush}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource NskBodyStrongTextStyle}"
                                        Foreground="{ThemeResource NskTextPrimaryBrush}"
                                        Text="{TemplateBinding Title}" />
                                    <TextBlock
                                        Style="{StaticResource NskCaptionTextStyle}"
                                        Foreground="{ThemeResource NskTextSecondaryBrush}"
                                        Text="{TemplateBinding StatusCaption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button
                                        x:Name="PART_PauseButton"
                                        Content="{TemplateBinding PauseResumeLabel}"
                                        Command="{TemplateBinding PauseResumeCommand}"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="PART_CancelButton"
                                        Content="{TemplateBinding CancelLabel}"
                                        Command="{TemplateBinding CancelCommand}"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar
                                IsIndeterminate="{TemplateBinding IsIndeterminate}"
                                Minimum="0"
                                Maximum="100"
                                Value="{TemplateBinding ProgressValue}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- InlineProgressIndicator -->
    <Style TargetType="controls:InlineProgressIndicator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:InlineProgressIndicator">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualState x:Name="Active" />
                                <VisualState x:Name="Idle">
                                    <VisualState.Setters>
                                        <Setter Target="Ring.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ProgressRing
                            x:Name="Ring"
                            Width="16"
                            Height="16"
                            IsActive="{TemplateBinding IsActive}" />
                        <TextBlock
                            Style="{StaticResource NskCaptionTextStyle}"
                            Foreground="{ThemeResource NskTextSecondaryBrush}"
                            Text="{TemplateBinding Caption}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ModuleCardBoundary -->
    <Style TargetType="controls:ModuleCardBoundary">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ModuleCardBoundary">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="HealthStates">
                                <VisualState x:Name="HealthyState">
                                    <VisualState.Setters>
                                        <Setter Target="HealthyHost.Visibility" Value="Visible" />
                                        <Setter Target="FallbackStateView.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="FallbackState">
                                    <VisualState.Setters>
                                        <Setter Target="HealthyHost.Visibility" Value="Collapsed" />
                                        <Setter Target="FallbackStateView.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="HealthyHost"
                            Content="{TemplateBinding ModuleContent}" />
                        <controls:StateView
                            x:Name="FallbackStateView"
                            Visibility="Collapsed"
                            State="{TemplateBinding FallbackViewState}"
                            Title="{TemplateBinding FallbackHeading}"
                            Message="{TemplateBinding StatusMessage}"
                            PrimaryActionLabel="{TemplateBinding RetryLabel}"
                            PrimaryActionCommand="{TemplateBinding RetryCommand}"
                            SecondaryActionLabel="{TemplateBinding ConfigureLabel}"
                            SecondaryActionCommand="{TemplateBinding ConfigureCommand}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
