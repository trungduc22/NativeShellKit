<ResourceDictionary
    x:Class="NativeShellKit.DesignSystem.Themes.DesignSystemThemeResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///NativeShellKit.DesignSystem/Themes/Tokens/SurfacesAndColors.xaml" />
        <ResourceDictionary Source="ms-appx:///NativeShellKit.DesignSystem/Themes/Tokens/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///NativeShellKit.DesignSystem/Themes/Tokens/MetricsAndRadii.xaml" />
        <ResourceDictionary Source="ms-appx:///NativeShellKit.DesignSystem/Themes/Tokens/DensityStandard.xaml" />
        <ResourceDictionary Source="ms-appx:///NativeShellKit.DesignSystem/Themes/Tokens/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="NskCardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource NskRadiusCard}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource NskCardPadding}" />
        <Setter Property="Background" Value="{ThemeResource NskSurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NskStrokeCardBrush}" />
    </Style>

    <Style x:Key="NskSubtleSurfaceBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource NskRadiusControl}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="{ThemeResource NskSurfaceSubtleBrush}" />
    </Style>

    <!-- v1 backwards-compatibility alias -->
    <Style x:Key="NativeShellCardBorderStyle" BasedOn="{StaticResource NskCardBorderStyle}" TargetType="Border" />
</ResourceDictionary>
